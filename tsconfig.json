{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["react", "react-native"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "example", "**/*.test.ts"]
}
